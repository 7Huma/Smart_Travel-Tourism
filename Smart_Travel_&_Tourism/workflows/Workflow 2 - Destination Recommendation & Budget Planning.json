      "parameters": {
        "sendTo": "={{ $('Generate Markdown Report').item.json.email }}",
        "subject": "Your Personalized Travel Recommendations",
        "message": "=<h2>Hello {{ $('Generate Markdown Report').item.json.fullName }},</h2>\n<p>Here are your personalized travel recommendations based on your budget of {{ $('Generate Markdown Report').item.json.currency }} {{ $('Generate Markdown Report').item.json.totalBudget }} for {{ $('Generate Markdown Report').item.json.tripDuration }} days.</p>\n<h3>Budget Summary</h3>\n<ul>\n<li>Total Budget: {{ $('Generate Markdown Report').item.json.currency }} {{ $('Generate Markdown Report').item.json.totalBudget }}</li>\n<li>Budget Per Traveler: {{ $('Generate Markdown Report').item.json.currency }} {{ $('Generate Markdown Report').item.json.budgetPerTraveler }}</li>\n<li>Daily Budget: {{ $('Generate Markdown Report').item.json.currency }} {{ $('Generate Markdown Report').item.json.dailyBudget }}</li>\n<li>Budget Category: {{ $('Generate Markdown Report').item.json.budgetCategory }}</li>\n</ul>\n<h3>Top 3 Destinations</h3>\n{{ $('Generate Markdown Report').item.json.topDestinations.map((d, i) => '<p><b>' + (i+1) + '. ' + d.destinationName + ', ' + d.country + '</b><br>Why: ' + d.whyItMatches + '<br>Estimated Cost: ' + $('Generate Markdown Report').item.json.currency + ' ' + d.estimatedTotalCost + '</p>').join('') }}\n<h3>AI Travel Tips</h3>\n<p>{{ $('Generate Markdown Report').item.json.topDestinations.map(d => (Array.isArray(d.travelTips) ? d.travelTips.join(', ') : d.travelTips)).join(' | ') }}</p>\n<p>Safe travels!<br>Smart Tourism & Travel Planning Platform</p>",
