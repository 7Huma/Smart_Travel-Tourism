    {
      "parameters": {
        "jsCode": "const traveler = $('Calculate Budget Metrics').first().json;\nconst destinations = $json.destinations || [];\n\nfunction toNum(v) { return Number(v) || 0; }\n\nfunction score(d) {\n  const adventure = toNum(d.adventureRating);\n  const relaxation = toNum(d.relaxationRating);\n  const safety = toNum(d.safetyRating);\n  const cost = toNum(d.estimatedTotalCost);\n  const budgetFit = traveler.totalBudget > 0\n    ? Math.max(0, 1 - Math.abs(cost - traveler.totalBudget) / traveler.totalBudget)\n    : 0;\n  return (adventure + relaxation + safety) * 0.6 + (budgetFit * 10) * 0.4;\n}\n\nconst ranked = destinations\n  .map(d => ({ ...d, matchScore: Math.round(score(d) * 100) / 100 }))\n  .sort((a, b) => b.matchScore - a.matchScore);\n\nconst topDestinations = ranked.slice(0, 3);\n\nreturn [{\n  json: {\n    ...traveler,\n    allDestinations: ranked,\n    topDestinations\n  }\n}];"
      },
      "id": "db458255-7a7f-412f-ae28-56699a5ed1aa",
      "name": "Rank And Select Top3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst top = item.topDestinations || [];\n\nconst fmtList = (arr) => Array.isArray(arr) ? arr.join(', ') : (arr || 'N/A');\n\nlet destinationsSection = '';\ntop.forEach((d, i) => {\n  destinationsSection += `\\n### ${i + 1}. ${d.destinationName || 'N/A'}, ${d.country || 'N/A'}\\n`;\n  destinationsSection += `**Why it matches:** ${d.whyItMatches || 'N/A'}\\n\\n`;\n  destinationsSection += `- Estimated Total Cost: ${item.currency} ${d.estimatedTotalCost || 'N/A'}\\n`;\n  destinationsSection += `- Average Hotel Cost: ${item.currency} ${d.averageHotelCost || 'N/A'}\\n`;\n  destinationsSection += `- Average Food Cost: ${item.currency} ${d.averageFoodCost || 'N/A'}\\n`;\n  destinationsSection += `- Average Transport Cost: ${item.currency} ${d.averageTransportCost || 'N/A'}\\n`;\n  destinationsSection += `- Recommended Activities: ${fmtList(d.recommendedActivities)}\\n`;\n  destinationsSection += `- Best Months To Visit: ${fmtList(d.bestMonthsToVisit)}\\n`;\n  destinationsSection += `- Weather Summary: ${d.weatherSummary || 'N/A'}\\n`;\n  destinationsSection += `- Travel Tips: ${fmtList(d.travelTips)}\\n`;\n  destinationsSection += `- Safety Rating: ${d.safetyRating || 'N/A'}/10\\n`;\n  destinationsSection += `- Family Friendly: ${d.familyFriendly || 'N/A'}\\n`;\n  destinationsSection += `- Adventure Rating: ${d.adventureRating || 'N/A'}/10\\n`;\n  destinationsSection += `- Relaxation Rating: ${d.relaxationRating || 'N/A'}/10\\n`;\n  destinationsSection += `- Match Score: ${d.matchScore || 'N/A'}\\n`;\n});\n\nconst estimatedTotalCost = top.reduce((sum, d) => sum + (Number(d.estimatedTotalCost) || 0), 0) / (top.length || 1);\n\nconst markdownReport = `# Personalized Travel Recommendation Report\n\n## Traveler Summary\n- Name: ${item.fullName}\n- Email: ${item.email}\n- Country: ${item.country}\n- Departure City: ${item.departureCity}\n- Travel Dates: ${item.travelStartDate} to ${item.travelEndDate} (${item.tripDuration} days)\n- Number Of Travelers: ${item.numberOfTravelers}\n- Travel Style: ${item.travelStyle}\n- Interests: ${item.interests}\n\n## Budget Analysis\n- Total Budget: ${item.currency} ${item.totalBudget}\n- Budget Per Traveler: ${item.currency} ${item.budgetPerTraveler}\n- Daily Budget: ${item.currency} ${item.dailyBudget}\n- Daily Budget Per Traveler: ${item.currency} ${item.dailyBudgetPerTraveler}\n- Budget Category: ${item.budgetCategory}\n\n## Top 3 Recommended Destinations\n${destinationsSection}\n\n## Cost Breakdown\nAverage estimated cost across top picks: ${item.currency} ${Math.round(estimatedTotalCost * 100) / 100}\n\n## Travel Tips\n${top.map(d => fmtList(d.travelTips)).join('\\n')}\n\n## Suggested Packing Advice\nPack according to the weather summaries above, include appropriate clothing for ${fmtList(top.map(d => d.weatherSummary))}, comfortable walking shoes, universal adapter, travel documents, and season-appropriate essentials for a ${item.travelStyle} style trip.\n\n## Important Notes\n- Prices are estimates and may vary by season and booking time.\n- Special Requirements: ${item.specialRequirements || 'None'}\n- Additional Comments: ${item.comments || 'None'}\n`;\n\nreturn [{\n  json: {\n    ...item,\n    estimatedTotalCost: Math.round(estimatedTotalCost * 100) / 100,\n    markdownReport\n  }\n}];"
      },
