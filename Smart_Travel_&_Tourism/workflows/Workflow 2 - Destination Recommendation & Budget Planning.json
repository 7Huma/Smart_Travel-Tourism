    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst errors = [];\n\nif (!item.fullName) errors.push('fullName is required');\nif (!item.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(item.email)) errors.push('valid email is required');\nif (!item.budget || item.budget <= 0) errors.push('budget must be greater than 0');\nif (!item.travelStartDate || !item.travelEndDate) errors.push('travelStartDate and travelEndDate are required');\nif (item.travelStartDate && item.travelEndDate) {\n  const start = new Date(item.travelStartDate);\n  const end = new Date(item.travelEndDate);\n  if (isNaN(start.getTime()) || isNaN(end.getTime())) errors.push('travel dates are invalid');\n  else if (end <= start) errors.push('travelEndDate must be after travelStartDate');\n}\nif (!item.numberOfTravelers || item.numberOfTravelers <= 0) errors.push('numberOfTravelers must be greater than 0');\n\nreturn [{\n  json: {\n    ...item,\n    isValid: errors.length === 0,\n    validationErrors: errors\n  }\n}];"
      },
