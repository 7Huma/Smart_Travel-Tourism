    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst budget = Number(item.budget) || 0;\nconst travelers = Number(item.numberOfTravelers) || 1;\nconst start = new Date(item.travelStartDate);\nconst end = new Date(item.travelEndDate);\nconst durationMs = end - start;\nconst tripDuration = Math.max(1, Math.ceil(durationMs / (1000 * 60 * 60 * 24)));\n\nconst budgetPerTraveler = budget / travelers;\nconst dailyBudget = budget / tripDuration;\nconst dailyBudgetPerTraveler = budgetPerTraveler / tripDuration;\n\nlet budgetCategory = 'Budget';\nif (dailyBudgetPerTraveler > 50 && dailyBudgetPerTraveler <= 150) budgetCategory = 'Standard';\nelse if (dailyBudgetPerTraveler > 150 && dailyBudgetPerTraveler <= 350) budgetCategory = 'Premium';\nelse if (dailyBudgetPerTraveler > 350) budgetCategory = 'Luxury';\n\nreturn [{\n  json: {\n    ...item,\n    totalBudget: budget,\n    budgetPerTraveler: Math.round(budgetPerTraveler * 100) / 100,\n    dailyBudget: Math.round(dailyBudget * 100) / 100,\n    dailyBudgetPerTraveler: Math.round(dailyBudgetPerTraveler * 100) / 100,\n    tripDuration,\n    budgetCategory\n  }\n}];"
      },
      "id": "a9ec1876-8e28-412f-98cd-e828e9da307d",
      "name": "Calculate Budget Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Handle new \"Message a model\" (Responses API) format\nlet content = '';\nif (raw.output && Array.isArray(raw.output)) {\n  const msg = raw.output.find(o => o.type === 'message');\n  if (msg && msg.content && Array.isArray(msg.content)) {\n    const textBlock = msg.content.find(c => c.type === 'output_text');\n    content = textBlock ? textBlock.text : '';\n  }\n} else {\n  // fallback for older chat completion formats\n  content = raw.message?.content ?? raw.choices?.[0]?.message?.content ?? raw.text ?? raw.content ?? '';\n}\n\nif (typeof content !== 'string') content = JSON.stringify(content);\n\nlet parsed;\ntry {\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(jsonMatch ? jsonMatch[0] : content);\n} catch (e) {\n  return [{ json: { parseSuccess: false, parseError: e.message, rawContent: content } }];\n}\n\nconst destinations = Array.isArray(parsed) ? parsed : (parsed.destinations || []);\n\nif (!destinations.length) {\n  return [{ json: { parseSuccess: false, parseError: 'No destinations found in AI response', rawContent: content } }];\n}\n\nreturn [{ json: { parseSuccess: true, destinations, count: destinations.length } }];"
      },
