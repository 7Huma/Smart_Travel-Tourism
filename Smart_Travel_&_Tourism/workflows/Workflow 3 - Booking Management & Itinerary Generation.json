    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nlet markdown = `# Travel Itinerary\\n\\n`;\nmarkdown += `**Traveler Name:** ${data.fullName}\\n`;\nmarkdown += `**Destination:** ${data.destinationName}, ${data.country}\\n`;\nmarkdown += `**Trip Duration:** ${data.tripDays} days\\n`;\nmarkdown += `**Budget:** ${data.currency} ${data.budget}\\n`;\nmarkdown += `**Estimated Cost:** ${data.currency} ${data.totalItineraryCost}\\n\\n`;\n\nmarkdown += `## Day-wise Itinerary\\n\\n`;\n(data.dayWiseItinerary || []).forEach(day => {\n  markdown += `### Day ${day.day}\\n`;\n  markdown += `- **Morning:** ${day.morning}\\n`;\n  markdown += `- **Afternoon:** ${day.afternoon}\\n`;\n  markdown += `- **Evening:** ${day.evening}\\n`;\n  markdown += `- **Hotel:** ${day.hotel}\\n`;\n  markdown += `- **Transport:** ${day.transport}\\n`;\n  markdown += `- **Estimated Daily Cost:** ${data.currency} ${day.estimatedDailyCost}\\n\\n`;\n});\n\nmarkdown += `## Packing Checklist\\n`;\n(data.packingChecklist || []).forEach(item => {\n  markdown += `- ${item}\\n`;\n});\n\nmarkdown += `\\n## Important Travel Tips\\n`;\n(data.importantTravelTips || []).forEach(tip => {\n  markdown += `- ${tip}\\n`;\n});\n\nmarkdown += `\\n## Booking Checklist\\n`;\n(data.bookingChecklist || []).forEach(item => {\n  markdown += `- ${item}\\n`;\n});\n\nconst hotelSummary = (data.dayWiseItinerary || []).map(d => d.hotel).filter((v,i,a)=>v && a.indexOf(v)===i).join(', ');\nconst transportSummary = (data.dayWiseItinerary || []).map(d => d.transport).filter((v,i,a)=>v && a.indexOf(v)===i).join(', ');\nconst packingChecklistText = (data.packingChecklist || []).join(', ');\nconst travelTipsText = (data.importantTravelTips || []).join(', ');\n\nreturn [{\n  json: {\n    ...data,\n    markdownItinerary: markdown,\n    hotelSummary,\n    transportSummary,\n    packingChecklistText,\n    travelTipsText\n  }\n}];"
      },
