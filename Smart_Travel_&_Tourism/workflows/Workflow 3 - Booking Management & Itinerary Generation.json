      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst normalized = {\n  travelerId: input.travelerId || input.travelerID || '',\n  fullName: input.fullName || '',\n  email: input.email || '',\n  phoneNumber: input.phoneNumber || '',\n  destinationName: input.destinationName || input.selectedDestination || input.destination || '',\n  country: input.country || '',\n  travelStartDate: input.travelStartDate || '',\n  travelEndDate: input.travelEndDate || '',\n  budget: Number(input.budget) || 0,\n  currency: input.currency || 'USD',\n  numberOfTravelers: Number(input.numberOfTravelers) || 1,\n  travelStyle: input.travelStyle || '',\n  interests: input.interests || '',\n  accommodationPreference: input.accommodationPreference || '',\n  preferredTransport: input.preferredTransport || '',\n  specialRequirements: input.specialRequirements || '',\n  estimatedTotalCost: Number(input.estimatedTotalCost) || 0,\n  averageHotelCost: Number(input.averageHotelCost) || 0,\n  averageFoodCost: Number(input.averageFoodCost) || 0,\n  averageTransportCost: Number(input.averageTransportCost) || 0,\n  recommendedActivities: input.recommendedActivities || [],\n  bestMonthsToVisit: input.bestMonthsToVisit || []\n};\n\nreturn [{ json: normalized }];"
      },
