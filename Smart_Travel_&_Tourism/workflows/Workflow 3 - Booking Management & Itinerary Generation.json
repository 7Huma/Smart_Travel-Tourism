    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst startDate = new Date(data.travelStartDate);\nconst endDate = new Date(data.travelEndDate);\nlet tripDays = Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;\nif (!tripDays || tripDays < 1) tripDays = 1;\n\nconst hotelCost = (data.averageHotelCost || 0) * tripDays;\nconst transportCost = (data.averageTransportCost || 0);\nconst foodCost = (data.averageFoodCost || 0) * tripDays;\nconst miscCost = Math.round((hotelCost + transportCost + foodCost) * 0.1);\nconst totalItineraryCost = hotelCost + transportCost + foodCost + miscCost;\n\nreturn [{\n  json: {\n    ...data,\n    tripDays,\n    hotelCost,\n    transportCost,\n    foodCost,\n    miscCost,\n    totalItineraryCost\n  }\n}];"
      },
      "id": "d915463e-7406-4c13-91a9-c01a132831f7",
      "name": "Calculate Budget & Duration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -976,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nlet aiText = '';\n\ntry {\n  if (raw.output && raw.output[0] && raw.output[0].content && raw.output[0].content[0]) {\n    aiText = raw.output[0].content[0].text;\n  } else if (raw.message && raw.message.content) {\n    aiText = raw.message.content;\n  } else if (raw.choices && raw.choices[0] && raw.choices[0].message) {\n    aiText = raw.choices[0].message.content;\n  } else if (raw.text) {\n    aiText = raw.text;\n  } else if (typeof raw === 'string') {\n    aiText = raw;\n  } else {\n    aiText = JSON.stringify(raw);\n  }\n} catch (e) {\n  aiText = '';\n}\n\nlet parsed = {};\nlet parseSuccess = true;\nlet errorMessage = '';\n\ntry {\n  const cleaned = aiText.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parseSuccess = false;\n  errorMessage = error.message;\n  parsed = {};\n}\n\nconst previous = $('Calculate Budget & Duration').first().json;\n\nreturn [{\n  json: {\n    ...previous,\n    parseSuccess,\n    errorMessage,\n    dayWiseItinerary: parsed.dayWiseItinerary || [],\n    packingChecklist: parsed.packingChecklist || [],\n    importantTravelTips: parsed.importantTravelTips || [],\n    bookingChecklist: parsed.bookingChecklist || []\n  }\n}];"
      },
