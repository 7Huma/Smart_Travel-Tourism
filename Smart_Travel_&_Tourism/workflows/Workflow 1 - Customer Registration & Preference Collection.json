      "id": "776e6124-9b14-4460-a617-e52c416148a9",
      "name": "Rename Fields (Clean JSON)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -592,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst errors = [];\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!item.email || !emailRegex.test(item.email)) {\n  errors.push('Invalid or missing email address.');\n}\n\nconst phoneRegex = /^[+]?[0-9\\s-]{7,15}$/;\nif (!item.phoneNumber || !phoneRegex.test(item.phoneNumber)) {\n  errors.push('Invalid or missing phone number.');\n}\n\nif (item.budget === undefined || item.budget === null || isNaN(item.budget) || item.budget <= 0) {\n  errors.push('Budget must be a number greater than 0.');\n}\n\nlet travelDateValid = true;\nlet parsedDate = null;\nif (!item.travelDates) {\n  travelDateValid = false;\n} else {\n  const rawDate = String(item.travelDates)\n  .split(/\\s+to\\s+|–/)[0]\n  .trim();\n\n  parsedDate = new Date(rawDate);\n  if (isNaN(parsedDate.getTime())) {\n    travelDateValid = false;\n  } else {\n    const today = new Date();\n    today.setHours(0,0,0,0);\n    if (parsedDate < today) {\n      travelDateValid = false;\n    }\n  }\n}\nif (!travelDateValid) {\n  errors.push('Travel date is missing, invalid, or in the past.');\n}\n\nconst requiredFields = [\n  'fullName','email','phoneNumber','age','country','departureCity',\n  'travelDates','tripDuration','numberOfTravelers','budget','currency',\n  'travelStyle','interests','transportPreference','accommodationPreference'\n];\n\nfor (const field of requiredFields) {\n  const val = item[field];\n  if (val === undefined || val === null || String(val).trim() === '') {\n    errors.push('Missing required field: ' + field);\n  }\n}\n\nreturn [{\n  json: {\n    ...item,\n    isValid: errors.length === 0,\n    validationErrors: errors,\n    validationErrorsText: errors.join(' | ')\n  }\n}];"
      },
