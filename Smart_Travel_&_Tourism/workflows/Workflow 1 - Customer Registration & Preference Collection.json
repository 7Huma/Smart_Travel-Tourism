    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Action Required: Issue with Your Travel Registration Form",
        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif; color:#333;\">\n  <h2 style=\"color:#c0392b;\">Registration Could Not Be Processed</h2>\n  <p>Dear {{ $json.fullName || 'Traveler' }},</p>\n  <p>We received your travel registration form, but the following issue(s) were found:</p>\n  <ul>\n    {{ $json.validationErrors.map(e => '<li>' + e + '</li>').join('') }}\n  </ul>\n  <p>Please resubmit the form with corrected details so we can proceed with your registration.</p>\n  <p>Best regards,<br/>Smart Tourism & Travel Planning Platform</p>\n</body>\n</html>",
        "options": {}
      },
