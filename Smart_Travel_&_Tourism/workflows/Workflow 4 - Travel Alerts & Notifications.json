    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nlet markdown = `# Travel Reminder\\n\\n`;\nmarkdown += `**Traveler:** ${data.fullName}\\n`;\nmarkdown += `**Destination:** ${data.destination}\\n`;\nmarkdown += `**Travel Date:** ${data.travelStartDate} to ${data.travelEndDate}\\n\\n`;\n\nmarkdown += `## Weather\\n${data.weatherAdvisory}\\n\\n`;\n\nmarkdown += `## Packing Tips\\n`;\n(data.packingChecklist || []).forEach(item => {\n  markdown += `- ${item}\\n`;\n});\n\nmarkdown += `\\n## Safety Advice\\n`;\n(data.localSafetyTips || []).forEach(tip => {\n  markdown += `- ${tip}\\n`;\n});\n\nmarkdown += `\\n## Transport Reminder\\n${data.transportationReminder}\\n\\n`;\nmarkdown += `## Airport Arrival Reminder\\n${data.airportArrivalReminder}\\n\\n`;\nmarkdown += `## Currency Reminder\\n${data.currencyReminder}\\n\\n`;\n\nmarkdown += `## Language Tips\\n`;\n(data.languageTips || []).forEach(tip => {\n  markdown += `- ${tip}\\n`;\n});\n\nmarkdown += `\\n## Health Precautions\\n`;\n(data.healthPrecautions || []).forEach(item => {\n  markdown += `- ${item}\\n`;\n});\n\nmarkdown += `\\n## Cultural Etiquette\\n`;\n(data.culturalEtiquette || []).forEach(item => {\n  markdown += `- ${item}\\n`;\n});\n\nmarkdown += `\\n## Emergency Tips\\n${data.emergencyContactsReminder}\\n\\n`;\nmarkdown += `Have a great trip!\\n`;\n\nconst packingChecklistText = (data.packingChecklist || []).join(', ');\nconst safetyTipsText = (data.localSafetyTips || []).join(', ');\n\nreturn [{\n  json: {\n    ...data,\n    markdownMessage: markdown,\n    packingChecklistText,\n    safetyTipsText,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
