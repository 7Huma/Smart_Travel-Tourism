    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nlet aiText = '';\n\ntry {\n  if (Array.isArray(raw.output)) {\n    const assistantItem = raw.output.find(item => item.role === 'assistant');\n    if (assistantItem && Array.isArray(assistantItem.content) && assistantItem.content[0]) {\n      aiText = assistantItem.content[0].text || '';\n    }\n  }\n\n  if (!aiText && raw.message && raw.message.content) {\n    aiText = raw.message.content;\n  } else if (!aiText && raw.choices && raw.choices[0] && raw.choices[0].message) {\n    aiText = raw.choices[0].message.content;\n  } else if (!aiText && raw.text) {\n    aiText = raw.text;\n  } else if (!aiText && typeof raw === 'string') {\n    aiText = raw;\n  }\n} catch (e) {\n  aiText = '';\n}\n\nlet parsed = {};\nlet parseSuccess = true;\nlet errorMessage = '';\n\ntry {\n  const cleaned = aiText.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parseSuccess = false;\n  errorMessage = error.message;\n  parsed = {};\n}\n\nconst previous = $('Normalize Input').first().json;\n\nreturn [{\n  json: {\n    ...previous,\n    parseSuccess,\n    errorMessage,\n    weatherAdvisory: parsed.weatherAdvisory || '',\n    packingChecklist: parsed.packingChecklist || [],\n    localSafetyTips: parsed.localSafetyTips || [],\n    emergencyContactsReminder: parsed.emergencyContactsReminder || '',\n    currencyReminder: parsed.currencyReminder || '',\n    languageTips: parsed.languageTips || [],\n    transportationReminder: parsed.transportationReminder || '',\n    airportArrivalReminder: parsed.airportArrivalReminder || '',\n    healthPrecautions: parsed.healthPrecautions || [],\n    culturalEtiquette: parsed.culturalEtiquette || []\n  }\n}];"
      },
