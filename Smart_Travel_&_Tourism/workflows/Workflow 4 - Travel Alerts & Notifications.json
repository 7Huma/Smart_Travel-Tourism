        "jsCode": "const input = $input.first().json;\n\nconst normalized = {\n  travelerId: (input.travelerId || '').toString().trim(),\n  fullName: (input.fullName || '').toString().trim(),\n  email: (input.email || '').toString().trim(),\n  destination: (input.destination || '').toString().trim(),\n  travelStartDate: (input.travelStartDate || '').toString().trim(),\n  travelEndDate: (input.travelEndDate || '').toString().trim(),\n  bookingReference: (input.bookingReference || '').toString().trim(),\n  hotelName: (input.hotelName || '').toString().trim(),\n  transportType: (input.transportType || '').toString().trim(),\n  phoneNumber: (input.phoneNumber || '').toString().trim()\n};\n\nreturn [{ json: normalized }];"
      },
