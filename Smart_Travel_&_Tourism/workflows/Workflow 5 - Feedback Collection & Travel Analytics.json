      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"travelerId\": \"\",\n  \"bookingReference\": \"\",\n  \"fullName\": \"\",\n  \"email\": \"\",\n  \"destination\": \"\",\n  \"travelStartDate\": \"\",\n  \"travelEndDate\": \"\",\n  \"totalBudget\": \"\",\n  \"hotelName\": \"\",\n  \"transportType\": \"\"\n}"
      },
      "id": "9b56b428-73ed-4218-9455-765e71a59b34",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -192,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = items[0].json || {};\n\nfunction trimStr(v) {\n  if (v === undefined || v === null) return '';\n  return String(v).trim();\n}\n\nfunction toNumber(v, fallback) {\n  const n = parseFloat(v);\n  return isNaN(n) ? fallback : n;\n}\n\nconst normalized = {\n  travelerId: trimStr(input.travelerId),\n  bookingReference: trimStr(input.bookingReference),\n  fullName: trimStr(input.fullName) || 'Valued Traveler',\n  email: trimStr(input.email),\n  destination: trimStr(input.destination),\n  travelStartDate: trimStr(input.travelStartDate),\n  travelEndDate: trimStr(input.travelEndDate),\n  totalBudget: toNumber(input.totalBudget, 0),\n  hotelName: trimStr(input.hotelName) || 'Not specified',\n  transportType: trimStr(input.transportType) || 'Not specified'\n};\n\nreturn [{ json: normalized }];"
      },
      "id": "3f21de9e-9cb2-4cca-9ceb-43a2b46d8a95",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        32,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = items[0].json;\n\nconst requiredFields = ['travelerId', 'bookingReference', 'email', 'destination'];\nconst missing = requiredFields.filter(f => !d[f] || d[f] === '');\n\nreturn [{\n  json: {\n    ...d,\n    isValid: missing.length === 0,\n    missingFields: missing\n  }\n}];"
      },
      "id": "b9ea5d5b-c23a-4529-8f0b-f62601a7bcdf",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        256,
        16
      ]
    },
    {
