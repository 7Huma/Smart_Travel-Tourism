      "id": "665bc64b-2ba8-46a6-88da-4e4de1ef1d1e",
      "name": "Validation Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        704,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = items[0].json;\n\nconst markdown = `# Feedback Request\n\n**Traveler Name:** ${d.fullName}\n**Destination:** ${d.destination}\n**Trip Dates:** ${d.travelStartDate} to ${d.travelEndDate}\n**Booking Reference:** ${d.bookingReference}\n\n## Feedback Questions\n\n1. Overall Trip Rating (1-5)\n2. Hotel Rating (1-5)\n3. Transport Rating (1-5)\n4. Food Rating (1-5)\n5. Safety Rating (1-5)\n6. Destination Rating (1-5)\n7. Was the itinerary useful?\n8. Would you recommend this destination?\n9. What was your favorite part of the trip?\n10. What was your least favorite part?\n11. Any suggestions for improvement?\n12. Additional comments\n`;\n\nreturn [{\n  json: {\n    ...d,\n    feedbackFormMarkdown: markdown\n  }\n}];"
      },
      "id": "efbf876e-5a6d-43ee-9375-42fbd86cf286",
      "name": "Generate Feedback Form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        704,
        -80
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=How was your trip to {{ $json.destination }}?",
        "emailType": "text",
        "message": "=Hi {{ $json.fullName }},\n\nThank you for traveling with us to {{ $json.destination }}! We hope you had a wonderful trip.\n\nBooking Reference: {{ $json.bookingReference }}\nTrip Dates: {{ $json.travelStartDate }} to {{ $json.travelEndDate }}\n\nWe would love to hear about your experience. Please take a moment to answer the following:\n\nhttps://docs.google.com/forms/d/e/1FAIpQLSc1dCVF3eGFppVpKBgZ2PVDlirEyzC0a8-9GKj-WIgXzTrg1A/viewform\n\nYour feedback helps us improve our services for future travelers.\n\nIf you need any assistance, please contact our support team at support@smarttourism.example.com.\n\nSafe travels,\nSmart Tourism & Travel Planning Team",
        "options": {}
      },
